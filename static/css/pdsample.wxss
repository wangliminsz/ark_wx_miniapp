.filter-content {
  padding: 20rpx;
}

.filter-section {
  margin-bottom: 30rpx;
}

.filter-title {
  font-weight: normal;
  margin-bottom: 15px;
  display: block;
}

.filter-actions {
  display: flex;
  justify-content: center;
  /* 居中对齐 */
  align-items: center;
  padding: 0px 0;
  /* 减少上下内边距 */
  gap: 20px;
  /* 设置按钮之间的间距 */
}

.custom-filter-button {
  min-width: 75px !important;
  /* 设置最小宽度 */
  width: auto !important;
  /* 允许按钮根据内容自适应宽度 */
  padding: 0 12px !important;
  /* 减小左右内边距 */
  height: 36px !important;
  /* 设置按钮高度 */
  line-height: 30px !important;
  /* 调整行高以垂直居中文字 */
  font-size: 16px !important;
  /* 减小字体大小 */
  border-radius: 6% !important;
}

.custom-thin-button {
  min-width: 75px !important;
  /* 设置最小宽度 */
  width: auto !important;
  /* 允许按钮根据内容自适应宽度 */
  padding: 0 12px !important;
  /* 减小左右内边距 */
  height: 32px !important;
  /* 设置按钮高度 */
  line-height: 30px !important;
  /* 调整行高以垂直居中文字 */
  font-size: 14px !important;
  /* 减小字体大小 */
}



/* 重置按钮样式 */
.custom-thin-button.van-button--default {
  background-color: #f2f2f2 !important;
  /* 浅灰色背景 */
  color: #333 !important;
  border: none !important;
}

/* 确定按钮样式 */
.custom-thin-button.van-button--primary {
  background-color: #07c160 !important;
  /* 微信风格的绿色 */
  border: none !important;
}






/* 自定义复选框颜色 */
.custom-checkbox .van-checkbox__icon--checked {
  background-color: #07c160 !important;
  border-color: #07c160 !important;
}

.custom-checkbox .van-checkbox__icon--checked .van-icon {
  color: #fff !important;
}

/* 自定义单选框颜色 */
.custom-radio .van-radio__icon--checked {
  background-color: #07c160 !important;
  border-color: #07c160 !important;
}

.custom-radio .van-radio__icon--checked .van-icon {
  color: #fff !important;
}

/* 调整复选框和单选框的大小（可选） */
.custom-checkbox-icon,
.custom-radio-icon {
  font-size: 20px !important;
  /* 调整图标大小 */
}

/* 调整复选框和单选框文字的样式（可选） */
.custom-checkbox,
.custom-radio {
  font-size: 14px !important;
  /* 调整文字大小 */
  margin-bottom: 3px !important;
  /* 增加项目之间的间距 */
}







/* map map map again */

.map-container {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 120rpx;
  left: 0;
  background: #e66565;
}

.map{
  width: 100%;
  height: 100%;
}

.marker-info {
  position: absolute;
  top: 20px;
  right: 20px;
  background-color: white;
  padding: 5px;
  border-radius: 5px;
  box-shadow: 0 2px 5px rgba(0,0,0,0.2);
  font-size: 14px;
  min-width: 220px !important;
  min-height: 36px !important;
  
  /* 使用 Flexbox 实现垂直和水平居中 */
  display: flex;
  justify-content: center; /* 水平居中 */
  align-items: center; /* 垂直居中 */
  
  /* 确保文本不会换行 */
  white-space: nowrap;
  
  /* 移除按钮的默认样式 */
  border: none;
  outline: none;
  
  /* 可选：添加一些过渡效果 */
  transition: all 0.3s ease;
}

/* 可选：添加点击效果 */
.marker-info:active {
  transform: scale(0.98);
}