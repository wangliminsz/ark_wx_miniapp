.small-button {
  min-height: auto;
  background-color: transparent;
  border: 1px solid blue;
  border-radius: 4px;
}

.small-button::after {
  border: none;
}



/* Ensure content doesn't get hidden behind the Tabbar */
.page-content {
  padding-bottom: 120rpx;
}

.custom-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  /* Reduced height */
  padding-bottom: env(safe-area-inset-bottom);
  background-color: #f1f1f1;
  /* Changed to white */
  /* border-top: 1rpx solid #e0e0e0; */
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
}

.weui-tabbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.weui-tabbar__icon {
  width: 54rpx !important;
  height: 54rpx !important;
}

.weui-tabbar__label {
  font-size: 28rpx;
  color: #888;
  /* Default color */
  transition: color 0.3s;
  /* Smooth color transition */
}

/* Style for the selected tab */
.weui-tabbar__item.weui-bar__item_on .weui-tabbar__label {
  color: #007aff;
  /* Change this to your preferred highlight color */
}





.school-list {
  padding: 10px;
}

.school-item-normal {
  margin-bottom: 15px;
  border: 1px solid #808080;
  /* border: 1px solid #af0fff;  */
  border-radius: 8px;
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
}


.school-item {
  margin-bottom: 50px;
  border: 1px solid #808080;
  /* border: 1px solid #af0fff;  */
  border-radius: 8px;
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
}

.school-card {
  display: flex;
  padding: 10px;
}

.school-image {
  width: 75px;
  height: 65px;
  border-radius: 10px;
  margin-right: 12px;
}

.school-info {
  flex: 1;
}

.school-name {
  color: black;
  font-size: 16px;
  display: block;
  margin-bottom: 10px;
}

.school-detail {
  color: #0f000f;
  font-size: 12px;
  display: block;
  margin-top: 5px;
}

.more-info {
  text-align: right;
  color: #007fff;
  font-size: 12px;
  margin-top: 5px;
}








.school-search-section {
  display: flex;
  align-items: center;
  margin-right: 35px;
}

.school-search-container {
  /* position: relative; */
  width: 100%;
  display: flex;
  flex-direction: row;
  /* justify-content: space-between; */
  align-items: center;
  margin-top: 10px;
  margin-left: 10px;
  margin-right: 10px;
}

.school-search-input {
  flex: 1;
  width: 72vw;
  /* 视窗宽度的 80% */
  max-width: 100%;
  height: 30px;
  padding-left: 10px;
  box-sizing: border-box;
  border: 1px solid #ccc;
  border-radius: 5px;
}

.school-search-box {
  flex: 1;
  min-width: 0;
  /* 这个很重要，防止 flex item 不收缩 */
  margin-left: 10px;
  padding: 10px;
  /* border: 1px solid #ccc;
  border-radius: 5px; */
  text-align: left;
  /* 使文本居左 */
}

.school-icon-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 1px;
  margin-left: 15px;
  margin-right: 15px;
}

/* about ~~~~~~~~~~~~~~~~~ */

