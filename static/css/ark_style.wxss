.ark_container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  height: 100vh;
  /* height: calc(100vh - 45px); */
  background-color: #f0f0f0;
  padding: 40rpx;
}

.ark_logo-container {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}

.ark_logo {
  width: 100%;
  height: 100%;
}

.ark_title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 60rpx;
  text-align: center;
}

.ark_links-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.ark_link-item {
  width: 80%;
  padding: 20rpx;
  margin-bottom: 20rpx;
  background-color: #ffffff;
  border-radius: 10rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.ark_link-item text {
  font-size: 32rpx;
  color: #333333;
}

.ark_footer {
  margin-top: 30rpx;
  margin-bottom: 110rpx;
  font-size: 24rpx;
  color: #666666;
}