/* 2025-03-18 */
.tag-container {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.tag {
  background-color: #e6f3ff;
  color: #0066cc;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
  letter-spacing: 1px;
}

/* 2025-03-18 */


.text-red {
  margin-right: 3px;
  padding: 2px 5px;
  background-color: red;
  color: white;
  border-radius: 5px;
}

.text-green {
  padding: 2px 5px;
  background-color: green;
  color: white;
  border-radius: 5px;
}

.text-blue {
  padding: 2px 5px;
  background-color: blue;
  color: white;
  border-radius: 5px;
}

.text-bold {
  font-weight: bold;
  /* color: #ff0000; */
}

/* ~~~~~~~~ 回到顶部 */

.back-to-top {
  aspect-ratio: 1 / 1;
  position: fixed;
  bottom: 140px;
  right: 30px;
  width: 40px;
  height: 40px;
  /* background-color: #fff; */
  background-color: rgba(255, 255, 255, 0.4);
  /* color: white; */
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.back-to-top-icon {
  color: #ccc;
  /* transform: rotate(180deg);  */
  /* Rotate the icon by 180 degrees */
}

