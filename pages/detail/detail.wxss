@import "/static/css/mystyle.wxss"; 

.mycontent {
  flex: 1;
  text-align: left;
}

.mycontent_1 {
  /* flex: 1; */
  display: flex;
  flex-direction: row;
  text-align: left;
  justify-content: start;
}

.play-button {
  position: absolute;
  width: 50px; /* Adjust the size of the play button */
  height: 50px;
  background-color: rgba(0, 0, 0, 0.5); /* Semi-transparent background */
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translate(-50%, -50%);
}

.play-button::before {
  content: '';
  width: 0;
  height: 0;
  border-left: 20px solid white; /* Adjust the size of the triangle */
  border-top: 12px solid transparent;
  border-bottom: 12px solid transparent;
}

.absolute {
  position: absolute;
}
.top-2 {
  top: 0.75rem;
}
.left-2 {
  left: 0.75rem;
}

