.ark_container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f5f7fa 0%, #e4e8ec 100%);
}

.ark_logo-container {
  margin-top: 120rpx;
  margin-bottom: 40rpx;
}

.ark_logo {
  width: 180rpx;
  height: 180rpx;
}

.ark_title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
  text-align: center;
}

.ark_links-container {
  width: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.ark_login-box {
  width: 100%;
  max-width: 680rpx;
  padding: 60rpx 50rpx;
  background-color: transparent;
  border-radius: 24rpx;
  box-shadow: none;
}

.ark_login-label {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 50rpx;
}

.ark_form {
  display: flex;
  flex-direction: column;
}

.ark_form-item {
  margin-bottom: 35rpx;
}

.ark_form-item input {
  width: 100%;
  height: 100rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  border: 1px solid #e0e0e0;
  border-radius: 14rpx;
  box-sizing: border-box;
  background-color: #fff;
}

.ark_password-item {
  position: relative;
}

.ark_password-item input {
  padding-right: 100rpx;
}

.ark_password-eye {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #999;
  cursor: pointer;
}

.ark_form-item input:focus {
  border-color: #007AFF;
  outline: none;
}

.ark_login-button {
  margin-top: 60rpx;
  height: 80rpx;
  background-color: #007AFF;
  color: white;
  font-size: 30rpx;
  border-radius: 14rpx;
  border: none;
}

.ark_login-button:active {
  background-color: #0066cc;
}

.ark_footer {
  margin-top: auto;
  padding: 60rpx 40rpx;
  font-size: 26rpx;
  color: #999;
  text-align: center;
}