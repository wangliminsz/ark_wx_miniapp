<!-- Search 部分 ~~~~~~~~~~~~~~~~~~~~~~   -->

<view class="event-search-container">
  <!-- {{searchQuery}} -->
  <view>
    <input class="event-search-input" type="text" placeholder="Search..." bindinput="onEventSearchInput" value="{{searchQuery}}" />
  </view>

  <view style="display:flex; flex-direction: row; margin-right: 5px;">
    <view class="event-icon-container">
      <icon type="search" size="25" bindtap="onEventSearchGo"></icon>
      <view style="margin-right:5px;"></view>
      <icon type="clear" size="25" bindtap="onEventSearchReset"></icon>
    </view>
  </view>

</view>

<!-- Search 部分 ~~~~~~~~~~~~~~~~~~~~~~   -->




<!-- 顶部筛选 部分 ~~~~~~~~~~~~~~~~~~~~~~ -->

<view class="filter-bar">

  <picker bindchange="onAreaChange" value="{{areaIndex}}" range="{{areaOptions}}" range-key="text">
    <view class="picker">
      区域: {{areaOptions[areaIndex].text}}
    </view>
  </picker>

  <picker bindchange="bindTitleSortChange" value="{{titleSortIndex}}" range="{{titleSortOptions}}">
    <view class="picker">
      名称: {{titleSortOptions[titleSortIndex]}}
    </view>
  </picker>

  <picker bindchange="bindPriceSortChange" value="{{priceSortIndex}}" range="{{priceSortOptions}}">
    <view class="picker">
      价格: {{priceSortOptions[priceSortIndex]}}
    </view>
  </picker>
</view>

<!-- 顶部筛选 部分 ~~~~~~~~~~~~~~~~~~~~~~ -->




<!-- 主体 部分 ~~~~~~~~~~~~~~~~~~~~~~~~~ -->

<view>

  <block wx:for="{{propertyRecords}}" wx:key="id">
    <!-- bindtap="handleMyViewTap" -->
    <!-- <view data-id="{{item.id}}" data-item="{{item}}" bindtap="handleMyViewTap"> -->
    <view data-id="{{item.id}}" data-item="{{item}}">
      <view wx:if="{{item.w_title}}" class="myflex_column_01_new">

        <!-- 主图片 ~~  标题 ~~ 公众号文章/描述 -->
        <view wx:if="{{item.w_title}}" class="myflex_row_02">

          <!-- 图片部分 -->
          <!-- <view class="mytext_01"> -->
          <view data-id="{{item.id}}" data-item="{{item}}" bindtap="handleMyViewTap" class="mytext_01">
            <view wx:if="{{item.w_thumbnail}}" class="relative w-img-container">
              <image class="w-img" src="{{item.w_thumbnail}}" alt="{{item.w_title}}" />

              <view wx:if="{{item.w_status}}" class="absolute top-2 left-2 bg-white text-red px-0 py-0 text-xs rounded opacity-70">{{item.w_status}}
              </view>

              <view wx:if="{{item.w_code}}" class="absolute bottom-2 right-2 bg-gray-900 text-white px-0 py-0 text-xs rounded opacity-70">{{item.w_code}} </view>
            </view>
          </view>

          <!-- 文字部分 -->
          <view class="mytextflex relative">

            <!-- 标题 -->
            <view data-id="{{item.id}}" data-item="{{item}}" bindtap="handleMyViewTap" class="mytext_01">
              <text class="mb-2">{{item.w_title}}</text>
            </view>

            <!-- 公众号文章 或描述 -->
            <view style="margin: 10px;" wx:if="{{item.w_article_url}}">
              <button style="font-weight: normal; font-size: 15px; padding: 6px 6px; line-height: 1.5; min-height: 0; width: auto; display: inline-block;" bindtap="showArticle" data-url="{{item.w_article_url}}">公众号文章
              </button>
            </view>
            <view wx:else class="mytext_02">
              {{ item.w_desc }}
            </view>

          </view>

        </view>

        <!-- 起售价格 -->
        <!-- <view style="margin-bottom: 10px;">
          <text class="mb-2">起售价格：</text>
          <text class="mb-2">{{item.w_price}} 泰铢/平米</text>
        </view> -->

        <view style="margin-bottom: 10px; padding: 5px; border-radius: 10px; background: linear-gradient(135deg, #e6f4ff, #ffffff); position: relative; overflow: hidden;">
        
          <!-- Price Text -->
          <text style="font-size: 14px; color: #666;">起售价格：</text>
          <view style="display: flex; align-items: center; gap: 2px;">
            <text style="font-size: 14px; font-weight: bold; color: #333;">{{item.w_price}}</text>
            <text style="font-size: 14px; color: #888;">泰铢/平米</text>
          </view>
        </view>



      </view>

    </view>


  </block>


</view>

<!-- 主体 部分 ~~~~~~~~~~~~~~~~~~~~~~~~~ -->





<!-- 回到顶部 ~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

<view wx:if="{{showBackToTop}}" class="back-to-top" bindtap="scrollToTop">
  <!-- <icon type="download" size="30" class="back-to-top-icon" /> -->
  <image src="/static/images/up-arrow.svg" class="back-to-top"></image>
</view>

<!-- 回到顶部 ~~~~~~~~~~~~~~~~~~~~~~~~~~ -->