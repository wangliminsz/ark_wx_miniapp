@import "/static/css/mystyle.wxss"; 



.event-search-section {
  display: flex;
  align-items: center;
  margin-right: 35px;
}

.event-search-container {
  /* position: relative; */
  width: 100%;
  display: flex;
  flex-direction: row;
  /* justify-content: space-between; */
  align-items: center;
  margin-left: 10px;
  margin-right: 10px;
}

.event-search-input {
  flex: 1;
  width: 72vw; /* 视窗宽度的 80% */
  max-width: 100%;
  height: 30px;
  padding-left: 10px; 
  box-sizing: border-box;
  border: 1px solid #ccc;
  border-radius: 5px;
}

.event-search-box {
  flex: 1;
  min-width: 0; /* 这个很重要，防止 flex item 不收缩 */
  margin-left: 10px;
  padding: 10px;
  /* border: 1px solid #ccc;
  border-radius: 5px; */
  text-align: left; /* 使文本居左 */
}

.event-icon-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 1px;
  margin-left: 15px;
  margin-right: 15px;
}






.filter-bar {
  display: flex;
  /* justify-content: space-around; */
  justify-content: space-between;
  padding: 10px;
  background-color: #f8f8f8;
  font-size: smaller;
}

.picker {
  padding: 5px 10px;
  background-color: #fff;
  border: 1px solid #ddd;
  border-radius: 4px;
}



.bg-white {
  background-color: #fff;
}

.text-red {
  margin-right: 3px;
  padding: 2px 5px;
  background-color: red;
  color: white;
  border-radius: 5px;
}

/* General styles */
.content {
  margin-top: 5px;
}

.wd_card_content {
  padding: 10px;
}


.text-bold {
  font-weight: bold;
  color: #ff0000;
}

.title {
  margin-top: 12px;
  color: black;
  font-size: 15px;
  font-weight: bold;
}

.details {
  margin-top: 10px;
  color: #333333;
  font-size: 14px;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.myflex_column_01 {
  display: flex;
  flex-direction: column;
  margin-top: 10px;
  margin-left: 10px;
  margin-right: 10px;
  padding-left: 10px;
  padding-right: 10px;
  padding-top: 20px;
  /* padding-bottom: 20px; */
  border-radius: 4px;
  border: 1px solid rgb(160, 160, 160);
  /* justify-content: space-between; */
}

.myflex_row_01 {
  display: flex;
  flex-direction: row;
  /* margin: 10px;
  padding-left: 10px;
  padding-right: 10px;
  padding-top: 20px;
  padding-bottom: 20px; */
  border-radius: 4px;
  /* border: 1px solid rgb(224, 224, 224); */
  justify-content: space-between;
}

.myflex_row_02 {
  display: flex;
  flex-direction: row;
  /* margin: 10px;
  padding-left: 10px;
  padding-right: 10px;
  padding-top: 20px;
  padding-bottom: 20px; */
  border-radius: 4px;
	/* border: 1px solid rgb(224, 224, 224); */
}

.mytextflex {
  display: flex;
  flex-direction: column;
  position: relative;
}

.mytext_01 {
  margin-top: 20px;
  margin-bottom: 20px;
}

.mytext_02 {
  margin-bottom: 20px;
  font-size: 14px;
  font-weight: light;
  color: #494949
}

.myprice_cn{
  margin-left: 5px;
  font-weight: light;
  font-size: 14px;
  color: #a3a3a3;
}

.w-img-container {
  position: relative;
  width: 110px; /* Adjust the width as needed */
  height: 98px; /* Adjust the height as needed */
  margin-right: 12px;
}

.w-img {
  width: 110px; /* Adjust the width as needed */
  height: 98px; /* Adjust the height as needed */
  object-fit: cover;
  margin-right: 12px;
  border-radius: 4px;
}

.text-lg {
  font-size: 1rem;
  font-weight: normal;
}