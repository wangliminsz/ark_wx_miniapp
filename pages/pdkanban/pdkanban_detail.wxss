.picker-container, .input-container {
  width: 75%;
  padding-right: 10px;
}

.picker {
  background-color: #f0f0f0;
  padding: 5px 10px;
  border-radius: 5px;
  width: 100%;
  box-sizing: border-box;
  font-size: 14px;
}

.input-box {
  background-color: #f0f0f0;
  padding: 5px 10px;
  border-radius: 5px;
  width: 100% !important;
  box-sizing: border-box;
  font-size: 14px;
}

.button-container {
  width: 10%;
  margin-right: 20px;
}

.submit-btn {
  /* width: 100%; */
  width: 60px !important;
  padding: 5px 0;
  font-size: 14px;
  background-color: #007AFF;
  color: white;
  border: none;
  border-radius: 5px;
  text-align: center;
  line-height: 1.5;
}




.input-row {
  display: flex;
  align-items: center;
  /* margin-bottom: 10px; */
}

.label {
  width: 40%;
  font-size: 14px;
}

.input-box {
  width: 30%;
  height: 30px;
  border: 1px solid #ccc;
  border-radius: 4px;
  padding: 0 5px;
  font-size: 14px;
}


.small-button {
  width: 20%;
  height: 30px;
  line-height: 30px;
  font-size: 12px;
  margin-left: 10px;
  padding: 0;
}