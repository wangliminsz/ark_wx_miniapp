.es-memo-input {
  width: 100%;
  height: 60px;
  border: 1px solid #666;
  border-radius: 4px;
  padding: 8px;
  font-size: 14px;
  /* margin-right: 15px; */
}


.es-date-result {
  /* width: 100%; */
  /* height: 30px; */
  /* border: 1px solid #ddd; */
  /* border-radius: 4px; */
  /* padding: 0 8px; */
  font-size: 14px;
  /* line-height: 30px; */
  color: #000;
  /* margin-bottom: 8px; */
}

.es-date-picker, .es-time-picker {
  width: 100%;
  height: 30px;
  border: 1px solid #666;
  border-radius: 4px;
  padding: 0 8px;
  font-size: 14px;
  line-height: 30px;
  color: #666;
  /* margin-bottom: 8px; */
}



.memo-button {
  width: 100%;
  height: 35px;
  background-color: #4CAF50;
  color: #fff;
  border: none;
  border-radius: 4px;
  font-size: 14px;
  line-height: 1;
  text-align: center;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.3s ease; /* Smooth transition for color change */
}

.memo-button-disabled {
  background-color: #cccccc; /* Gray color */
  color: #666666; /* Darker text for better contrast */
  cursor: not-allowed; /* Changes cursor to indicate button is not clickable */
}

.dt-button {
  width: 100%;
  height: 35px;
  background-color: #4CAF50;
  color: #fff;
  border: none;
  border-radius: 4px;
  font-size: 14px;
  line-height: 1;
  text-align: center;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.3s ease; /* Smooth transition for color change */
}

.dt-button-disabled {
  background-color: #cccccc; /* Gray color */
  color: #666666; /* Darker text for better contrast */
  cursor: not-allowed; /* Changes cursor to indicate button is not clickable */
}




.finish-button {
  width: 120px !important;
  height: 35px;
  background-color: #007aff;
  color: #fff;
  border: none;
  border-radius: 4px;
  font-size: 15px;
  line-height: 1; /* Set to 1 to reset line height */
  text-align: center;
  padding: 0;
  display: flex; /* Use flexbox for centering */
  align-items: center; /* Center vertically */
  justify-content: center; /* Center horizontally */
}

.finish-button-no {
  background-color: #007aff;
  color: #fff;
}

.finish-button-yes {
  background-color: #cccccc;
  color: #666666;
}

.status-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 10px 0;
  width: 100%;
}

/* .picker-container {
  width: 75%;
