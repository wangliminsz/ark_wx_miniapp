@import "/static/css/mystyle.wxss";
@import "/static/css/pdsample.wxss";
@import "/pages/landlist/landlist.wxss"; 

/* Adjust other styles as needed */
.product-name, .product-quantity, .product-finished-container,
.es-memo-input, .es-date-picker, .es-time-picker,
.memo-button, .datetime-button, .finish-button {
  /* Remove any margin-top or margin-bottom from these elements */
  margin-top: 0;
  /* margin-bottom: 8px; */
}


.order-line-wrapper {
  margin: 5px -15px; /* Negative margin to counteract parent padding */
}

.order-line-border {
  border: 2px solid #87CEEB;
  border-radius: 2%;
  margin: 0 10px; /* Add margin to sides to create space between border and parent */
}

.order-line-content {
  padding-top: 10px;
  padding-bottom: 10px;
  padding-left: 10px;
  padding-right: 30px; /* Add padding inside the border */
}


.order-info {
  /* background-color: #fff;
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 16px; */
  margin-top: 0;
  border-top: none;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-code {
  font-size: 18px;
  font-weight: bold;
}

.order-status {
  font-size: 14px;
  color: #888;
}

.client-name {
  font-size: 16px;
  font-weight: bold;
  margin-top: 8px;
}

.order-date, .order-amount {
  font-size: 14px;
  color: #666;
  /* margin-top: 4px; */
}

.order-line {
  /* border-top: 1px solid #eee; */
  /* padding-top: 6px; */
  /* margin-top: 8px; */
  /* border-bottom: 1px solid #eee; */
  /* padding-bottom: 1px; */
  /* margin-bottom: 1px; */
  margin-top: 0;
  border-top: none;
}

.order-lines-container {
  border: 1px solid #ccc; /* You can adjust the color (#ccc) as needed */
  border-radius: 4px; /* Optional: adds rounded corners */
  padding: 1px; /* Adds some space inside the border */
  margin-top: 1px; /* Adds some space above the container */
}

.order-line:last-child {
  border-bottom: none; /* Removes the border from the last item */
  margin-bottom: 0;
  padding-bottom: 0;
}



.product-name {
  color: black;
  font-size: 16px;
  font-weight: normal;
}

.product-quantity {
  font-size: 14px;
  color: black;
  /* margin-top: 4px; */
}

.product-finished-container {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  /* margin-top: -60px; */
}

.product-finished {
  font-size: 14px;
}

.finished-no {
  color: black;
}

.finished-yes {
  color: blue;
}



