.location_container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7fa 0%, #e4e8ec 100%);
}

.location_header {
  padding: 40rpx 40rpx 20rpx;
  background: linear-gradient(135deg, #007AFF 0%, #0056b3 100%);
}

.header-content {
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.header-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

.action-bar {
  padding: 20rpx 30rpx;
  background: #fff;
}

.create-btn {
  width: 100%;
  background: linear-gradient(135deg, #007AFF 0%, #0056b3 100%);
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 22rpx;
  border: none;
}

.school-search-container {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  margin-top: 1px;
  box-sizing: border-box;
}

.school-search-input {
  flex: 1;
  font-size: 34rpx;
  width: 72vw;
  max-width: 100%;
  height: 70rpx;
  padding: 10rpx 20rpx;
  box-sizing: border-box;
  border: 1px solid #ccc;
  border-radius: 5px;
}

.school-icon-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-left: 15px;
  margin-right: 15px;
}

.location-list {
  flex: 1;
  padding: 20rpx 30rpx;
}

.location-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.item-left {
  flex: 1;
}

.item-code {
  font-size: 34rpx;
  font-weight: bold;
  color: #007AFF;
  margin-bottom: 8rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-remark {
  font-size: 24rpx;
  color: #999;
}

.arrow {
  font-size: 40rpx;
  color: #ccc;
  font-weight: 300;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon-wrapper {
  width: 180rpx;
  height: 180rpx;
  background-color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}

.empty-icon {
  font-size: 90rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 15rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}

.back-to-top {
  aspect-ratio: 1 / 1;
  position: fixed;
  bottom: 50px;
  right: 30px;
  width: 40px;
  height: 40px;
  background-color: rgba(255, 255, 255, 0.4);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
