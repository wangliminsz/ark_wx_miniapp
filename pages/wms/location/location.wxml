<view class="location_container">
  <view class="location_header">
    <view class="header-content">
      <text class="header-title">库位管理</text>
      <text class="header-subtitle">Location Management</text>
    </view>
  </view>

  <view class="action-bar">
    <button class="create-btn" bindtap="goToCreate">+ 新建库位</button>
  </view>

  <view class="school-search-container">
    <view>
      <input class="school-search-input" type="text" placeholder="搜索库位编码/名称" bindinput="onSearchInput" value="{{searchKey}}" confirm-type="search" bindconfirm="searchLocations" />
    </view>
    
    <view style="display: flex; flex-direction: row; margin-right: 5px;">
      <view class="school-icon-container">
        <icon type="search" size="25" bindtap="searchLocations" />
        <view style="margin-right: 5px;"></view>
        <icon type="clear" size="25" bindtap="resetSearch" />
      </view>
    </view>
  </view>

  <view class="location-list" wx:if="{{locations.length > 0}}">
    <view class="location-item" wx:for="{{locations}}" wx:key="id" bindtap="goToDetail" data-item="{{item}}">
      <view class="item-left">
        <view class="item-code">{{item.loc_code}}</view>
        <view class="item-name">{{item.loc_name}}</view>
      </view>
      <view class="item-right">
        <text class="item-remark">{{item.remark || '无备注'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{locations.length === 0 && !loading}}">
    <view class="empty-icon-wrapper">
      <text class="empty-icon">📍</text>
    </view>
    <text class="empty-title">暂无库位</text>
    <text class="empty-desc">点击上方按钮创建新库位</text>
  </view>
  
  <view wx:if="{{showBackToTop}}" class="back-to-top" bindtap="scrollToTop">
    <image src="/static/images/up-arrow.svg" class="back-to-top"></image>
  </view>
</view>
