page {
  background: #f5f7fa;
  font-size: 28rpx;
  min-height: 100vh;
}

.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 表单卡片 */
.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.form-title {
  margin-bottom: 32rpx;
}

.title-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2329;
}

/* 表单项 */
.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #495057;
  margin-bottom: 16rpx;
}

.input-wrapper {
  position: relative;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 30rpx;
  background: #fff;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #007AFF;
}

.form-input[disabled] {
  background: #f8f9fa;
  color: #868e96;
}

.form-textarea {
  width: 100%;
  min-height: 60rpx;
  height: 90rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 30rpx;
  background: #fff;
  box-sizing: border-box;
  line-height: 1.2;
}

.form-textarea:focus {
  border-color: #007AFF;
}

.input-placeholder {
  color: #adb5bd;
}

.input-tip {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #868e96;
}

/* 信息卡片 */
.info-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.info-title {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-title .title-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #666;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #868e96;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 底部按钮区 */
.footer-section {
  display: flex;
  gap: 24rpx;
  /* margin-top: auto; */
   margin-top: 20px;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #007AFF 0%, #0056b3 100%);
  color: #fff;
}

.btn-danger {
  background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
  color: #fff;
}

.btn-secondary {
  background: #fff;
  border: 2rpx solid #e0e0e0;
  color: #666;
}