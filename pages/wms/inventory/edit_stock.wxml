<view class="page-container">
  <!-- <view class="page-header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">‹</text>
      <text class="back-text">返回</text>
    </view>
    <view class="page-title">实物库存盘点</view>
  </view> -->

  <!-- 产品信息 -->
  <view class="product-info">
    <text class="product-name">{{productName}}</text>
    <text class="product-code">{{productCode}}</text>
    <view class="stock-info">
      <text class="label">账面库存</text>
      <text class="value">{{totalRealQty}} kg</text>
    </view>
  </view>

  <!-- 提示 -->
  <view class="tip">
    <text>💡 点击库位/批次可选择，数量支持小数</text>
  </view>

  <!-- 表格 -->
  <view class="table-wrapper">
    <view class="table">
      <view class="table-head">
        <view class="th loc">库位</view>
        <view class="th lot">批次</view>
        <view class="th qty">数量(kg)</view>
        <view class="th op">操作</view>
      </view>

      <scroll-view scroll-y class="table-body">
        <view wx:for="{{stockList}}" wx:key="*this" class="table-row">
          <view class="td loc">
            <picker mode="selector" range="{{locList}}" range-key="loc_code" bindchange="onLocChange" data-index="{{index}}">
              <view class="select-box">
                <text>{{item.loc_code || '请选择'}}</text>
                <text class="arrow">▼</text>
              </view>
            </picker>
          </view>

          <view class="td lot">
            <picker mode="selector" range="{{lotList}}" range-key="name" bindchange="onLotChange" data-index="{{index}}">
              <view class="select-box">
                <text>{{item.lot_name || '请选择'}}</text>
                <text class="arrow">▼</text>
              </view>
            </picker>
          </view>

          <view class="td qty">
            <input class="qty-input" type="digit" placeholder="0.00"
              value="{{item.real_qty}}" data-index="{{index}}" bindinput="onQtyInput" />
          </view>

          <view class="td op">
            <view class="del-btn" bindtap="onDelRow" data-index="{{index}}">✕</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="footer">
    <button class="btn-add" bindtap="onAddRow">+ 新增行</button>
    <button class="btn-save" bindtap="onSaveAll" loading="{{loading}}">保存全部</button>
  </view>
</view>