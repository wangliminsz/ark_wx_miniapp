<view class="page-container">

  <view class="upper-part">
    <!-- 提示 -->
    <view class="tip">
      <text>💡 点击库位/批次可选择，数量支持小数</text>
    </view>

    <!-- 分隔线 -->
    <view class="section-divider">
      <text class="divider-text">库存编辑</text>
    </view>

    <!-- 表格 -->
    <view class="table-wrapper">
      <view class="table">
        <view class="table-head">
          <view class="th loc">库位</view>
          <view class="th lot">批次</view>
          <view class="th qty">数量(kg)</view>
          <view class="th op">操作</view>
        </view>

        <scroll-view scroll-y class="table-body">
          <view wx:for="{{stockList}}" wx:key="*this" class="table-row">
            <!-- 库位：点击跳转到选择页面 -->
            <view class="td loc">
              <view class="select-box" bindtap="onSelectLocation" data-index="{{index}}">
                <text>{{item.loc_code || '请选择'}}</text>
                <text class="arrow">▼</text>
              </view>
            </view>

            <!-- 批次：保持原有的picker -->
            <view class="td lot">
              <picker mode="selector" range="{{lotList}}" range-key="name" bindchange="onLotChange" data-index="{{index}}">
                <view class="select-box">
                  <text>{{item.lot_name || '请选择'}}</text>
                  <text class="arrow">▼</text>
                </view>
              </picker>
            </view>

            <view class="td qty">
              <input class="qty-input" type="digit" placeholder="0.00" value="{{item.real_qty}}" data-index="{{index}}" bindinput="onQtyInput" />
            </view>

            <view class="td op">
              <view class="del-btn" bindtap="onDelRow" data-index="{{index}}">✕</view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- 底部按钮 -->
    <view class="footer">
      <button class="btn-add" bindtap="onAddRow">+ 新增行</button>
      <button class="btn-save" bindtap="onSaveAll" loading="{{loading}}">保存全部</button>
    </view>

    <!-- 底部色块 -->
    <view style="margin-top:20px; height: 15px; width:100%; background-color: #87CEEB;  border-radius: 0 0 5px 5px"></view>
    <!-- 底部色块 -->

  </view>



  <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
  <view class="lower-part">
    <!-- 产品信息 -->
    <view class="product-info">
      <text class="product-name">{{productName}}</text>
      <view class="product-code-wrapper">
        <text class="product-code">{{productCode}}</text>
      </view>
    </view>

    <!-- Odoo库存详情 -->
    <view class="odoo-table">
      <view class="odoo-table-header">
        <text class="table-cell location-cell">Odoo 库位</text>
        <text class="table-cell lot-cell">批次</text>
        <text class="table-cell qty-cell">数量</text>
      </view>
      <view wx:if="{{odooDetails.length > 0}}">
        <view class="odoo-detail-row" wx:for="{{odooDetails}}" wx:key="id">
          <text class="table-cell location-cell">{{item.location_truncated}}</text>
          <text class="table-cell lot-cell">{{item.lot_number}}</text>
          <text class="table-cell qty-cell">{{item.quantity}} kg</text>
        </view>
      </view>
      <view wx:else>
        <view class="odoo-detail-row empty-row">
          <text class="table-cell empty-text">没有 Odoo 账面库存</text>
        </view>
      </view>
    </view>

    <!-- 实物库存详情 -->
    <view class="physical-table">
      <view class="physical-table-header">
        <text class="table-cell loc-cell">实物库位</text>
        <text class="table-cell lot-cell">批次</text>
        <text class="table-cell qty-cell">数量</text>
      </view>
      <view wx:if="{{physicalDetails.length > 0}}">
        <view class="physical-detail-row" wx:for="{{physicalDetails}}" wx:key="id">
          <text class="table-cell loc-cell">{{item.loc_code}}</text>
          <text class="table-cell lot-cell">{{item.lot_number}}</text>
          <text class="table-cell qty-cell">{{item.real_qty}} kg</text>
        </view>
      </view>
      <view wx:else>
        <view class="physical-detail-row empty-row">
          <text class="table-cell empty-text">暂无实物库存</text>
        </view>
      </view>
    </view>

    <!-- 汇总 -->
    <view class="inventory-summary">
      <view class="summary-item">
        <text class="summary-label">账面</text>
        <text class="summary-value odoo-value">{{odooQty}} kg</text>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item">
        <text class="summary-label">实物</text>
        <text class="summary-value physical-value">{{totalRealQty}} kg</text>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item">
        <text class="summary-label">差异</text>
        <text class="summary-value diff-value {{diffQty > 0 ? 'positive' : diffQty < 0 ? 'negative' : ''}}">{{diffQty > 0 ? '+' : ''}}{{diffQtyDisplay}} kg</text>
      </view>
    </view>

  </view>
</view>