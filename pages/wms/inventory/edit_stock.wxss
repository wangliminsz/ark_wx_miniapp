page {
  background: #f7f8fa;
  font-size: 28rpx;
  min-height: 100vh;
}

.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-top: env(safe-area-inset-top);
}

/* 顶部导航 */
.page-header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.back-btn {
  display: flex;
  align-items: center;
}

.back-icon {
  font-size: 36rpx;
  color: #007AFF;
  margin-right: 8rpx;
}

.back-text {
  font-size: 28rpx;
  color: #007AFF;
}

.page-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

/* 产品信息 */
.product-info {
  background: #ffffff;
  padding: 30rpx;
  margin-bottom: 10rpx;
}

.product-name {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.product-code {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.stock-info {
  display: inline-flex;
  align-items: center;
  background: #f0f5ff;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
}

.stock-info .label {
  font-size: 24rpx;
  color: #666;
  margin-right: 10rpx;
}

.stock-info .value {
  font-size: 26rpx;
  font-weight: 500;
  color: #007AFF;
}

/* 提示 */
.tip {
  padding: 20rpx 30rpx;
  font-size: 24rpx;
  color: #999;
  background: #fff;
}

/* 表格 */
.table-wrapper {
  flex: 1;
  padding: 20rpx;
}

.table {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.table-head {
  display: flex;
  background: #f8f9fa;
  padding: 20rpx 0;
}

.th {
  text-align: center;
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid #f5f5f5;
  padding: 16rpx 0;
}

.td {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 列宽 */
.loc { width: 22%; }
.lot { width: 30%; }
.qty { width: 30%; }
.op  { width: 18%; }

/* 选择框 */
.select-box {
  width: 90%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 14rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.arrow {
  font-size: 20rpx;
  color: #999;
}

/* 数量输入框（完美居中） */
.qty-input {
  width: 90%;
  height: 60rpx;
  line-height: 60rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  text-align: center;
  font-size: 28rpx;
  background: #fff;
  box-sizing: border-box;
}

/* 删除按钮 */
.del-btn {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0f0;
  border-radius: 50%;
  color: #ff4d4f;
  font-size: 24rpx;
}

/* 底部 */
.footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}

.btn-add {
  flex: 1;
  background: #fff;
  border: 1rpx solid #007AFF;
  color: #007AFF;
  border-radius: 10rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
}

.btn-save {
  flex: 2;
  background: #07c160;
  color: #fff;
  border-radius: 10rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  border: none;
}