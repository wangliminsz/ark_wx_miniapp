page {
  background: #f7f8fa;
  font-size: 28rpx;
  min-height: 100vh;
}

.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-top: env(safe-area-inset-top);
  padding: 12rpx;
}

.upper-part {
  display: flex;
  flex-direction: column;
  padding-top: env(safe-area-inset-top);
  margin-left:5px;
  margin-right:5px;
  margin-top: 6px;
  margin-bottom: 40px;
  border: 2px solid #87CEEB;
  border-radius: 2%;
   /* Add margin to sides to create space between border and parent */
}

.order-line-border {
  border: 2px solid #87CEEB;
  border-radius: 2%;
  margin: 0 10px; /* Add margin to sides to create space between border and parent */
}

.lower-part {
  display: flex;
  flex-direction: column;
  padding-top: env(safe-area-inset-top);
  padding: 12rpx;
  margin-bottom: 40px;
}

/* 产品信息 */
.product-info {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}

.product-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #0024f0;
  line-height: 1.2;
  letter-spacing: 0.2rpx;
  word-break: break-all;
}

.product-code-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  margin-top: 16rpx;
}

.product-code {
  font-size: 35rpx;
  font-weight: bold;
  color: #000;
}

/* Odoo 表格样式 */
.odoo-table {
  display: flex;
  flex-direction: column;
  margin-top: 40rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.odoo-table-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #e3f2fd;
  padding: 14rpx 16rpx;
  border-bottom: 1rpx solid #bbdefb;
}

.odoo-detail-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #f1f8ff;
  padding: 12rpx 16rpx;
  border-bottom: 1rpx solid #e3f2fd;
}

.odoo-detail-row:last-child {
  border-bottom: none;
}

.table-cell {
  font-size: 24rpx;
  text-align: left;
}

.location-cell {
  flex: 2;
  color: #007AFF;
  font-weight: 500;
}

.lot-cell {
  flex: 1.5;
  color: #6c757d;
  text-align: left;
}

.qty-cell {
  flex: 1;
  color: #007AFF;
  font-weight: bold;
  text-align: right;
}

.odoo-table-header .table-cell {
  font-size: 22rpx;
  font-weight: 600;
  color: #007AFF;
}

/* 实物表格样式 */
.physical-table {
  display: flex;
  flex-direction: column;
  margin-top: 40rpx;
  margin-bottom: 40rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.physical-table-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #e6f4ea;
  padding: 14rpx 16rpx;
  border-bottom: 1rpx solid #c3e6cb;
}

.physical-detail-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #f1f8f4;
  padding: 12rpx 16rpx;
  border-bottom: 1rpx solid #e6f4ea;
}

.physical-detail-row:last-child {
  border-bottom: none;
}

.loc-cell {
  flex: 2;
  color: #28a745;
  font-weight: 500;
}

.physical-table-header .table-cell {
  font-size: 22rpx;
  font-weight: 600;
  color: #28a745;
}

.physical-table .qty-cell {
  color: #28a745;
}

.physical-detail-row.empty-row {
  justify-content: center;
}

.empty-text {
  color: #999;
  font-style: italic;
}

/* 汇总样式 */
.inventory-summary {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background-color: #f0f7ff;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  margin-top: 8rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.summary-label {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.summary-value {
  font-size: 28rpx;
  font-weight: bold;
}

.odoo-value {
  color: #007AFF;
}

.physical-value {
  color: #28a745;
}

.diff-value {
  color: #6c757d;
}

.diff-value.positive {
  color: #6f42c1;
}

.diff-value.negative {
  color: #dc3545;
}

.summary-divider {
  width: 1rpx;
  height: 40rpx;
  background-color: #d0d7de;
}

/* 提示 */
.tip {
  padding: 20rpx 30rpx;
  font-size: 24rpx;
  color: #999;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  margin-top: 40rpx;
}

/* 分隔线 */
.section-divider {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-divider::before,
.section-divider::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: linear-gradient(to right, transparent, #d0d7de, transparent);
}

.divider-text {
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #007AFF;
  font-weight: 600;
}

/* 表格 */
.table-wrapper {
  flex: 1;
  padding: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.table {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.table-head {
  display: flex;
  background: #f8f9fa;
  padding: 20rpx 0;
}

.th {
  text-align: center;
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid #f5f5f5;
  padding: 16rpx 0;
}

.td {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 列宽 */
.loc { width: 20%; }
.lot { width: 40%; }
.qty { width: 22%; }
.op  { width: 18%; }

/* 选择框 */
.select-box {
  width: 90%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 14rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.arrow {
  font-size: 20rpx;
  color: #999;
}

/* 数量输入框（完美居中） */
.qty-input {
  width: 90%;
  height: 60rpx;
  line-height: 60rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  text-align: center;
  font-size: 28rpx;
  background: #fff;
  box-sizing: border-box;
}

/* 批次手动输入框（内联布局） */
.lot-row {
  display: flex;
  align-items: center;
  width: 100%;
  gap: 6rpx;
  min-height: 60rpx;  /* 统一行高，保证 ✎ 图标纵向对齐 */
}

.lot-row picker {
  flex: 1;
  display: block;       /* 覆盖 picker 默认 inline-block，让它占满 flex 空间 */
  min-width: 0;
}

.lot-row .select-box {
  width: 100%;
  height: 60rpx;  /* 与 lot-input 同高 */
  line-height: 60rpx;
  padding: 0 12rpx;
  font-size: 24rpx;
  box-sizing: border-box;
  background: #f8f9fa;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.lot-input {
  flex: 1;
  min-width: 0;
  width: auto;
  height: 60rpx;
  line-height: 60rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  text-align: center;
  font-size: 24rpx;
  background: #fff;
  box-sizing: border-box;
}

/* 批次切换按钮（内联右侧，单字符图标） */
.lot-toggle {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #007AFF;
  background: #f0f8ff;
  border-radius: 8rpx;
}

.lot-toggle text {
  font-size: 28rpx;
  color: #007AFF;
}

/* 删除按钮 */
.del-btn {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0f0;
  border-radius: 50%;
  color: #ff4d4f;
  font-size: 24rpx;
}

/* 底部 */
.footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 24rpx;
  border-radius: 20rpx;
}

.btn-add {
  flex: 1;
  background: #fff;
  border: 1rpx solid #007AFF;
  color: #007AFF;
  border-radius: 10rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
}

.btn-save {
  flex: 2;
  background: #07c160;
  color: #fff;
  border-radius: 10rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  border: none;
}
