page {
  background: #f5f7fa;
  font-size: 28rpx;
  min-height: 100vh;
}

.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* 搜索框样式 - 与products页面保持一致 */
.school-search-container {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 10px;
  margin-left: 10px;
  margin-right: 10px;
  margin-bottom: 10px;
}

.school-search-input {
  flex: 1;
  font-size: 34rpx;
  width: 72vw;
  max-width: 100%;
  height: 30px;
  padding-left: 10px;
  box-sizing: border-box;
  border: 1px solid #ccc;
  border-radius: 5px;
}

.school-icon-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 1px;
  margin-left: 15px;
}

.table-wrapper {
  flex: 1;
  padding: 20rpx;
}

.table {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.table-head {
  display: flex;
  background: #f8f9fa;
  padding: 20rpx 0;
}

.th {
  text-align: center;
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid #f5f5f5;
  padding: 20rpx 0;
  align-items: center;
}

.td {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 列宽 */
.loc { width: 25%; }
.name { width: 45%; }
.remark { width: 30%; }

.loc-code {
  font-size: 28rpx;
  color: #007AFF;
  font-weight: 500;
}

.loc-name {
  font-size: 26rpx;
  color: #000;
  display: block;
  text-align: center;
}

.loc-remark {
  font-size: 26rpx;
  color: #333;
  display: block;
  text-align: center;
  margin-top: 4rpx;
}

.qty-badge {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
}

.qty-text {
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.loading-state,
.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
