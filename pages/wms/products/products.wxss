.products_container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7fa 0%, #e4e8ec 100%);
}

.products-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  background: linear-gradient(135deg, #007AFF 0%, #0056b3 100%);
}

.header-content {
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.header-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.header-count {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 15rpx 25rpx;
  border-radius: 16rpx;
}

.count-badge {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.count-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
}

.school-search-container {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 10px;
  margin-left: 10px;
  margin-right: 10px;
  margin-bottom: 10px;
}

.school-search-input {
  flex: 1;
  font-size: 34rpx;
  width: 72vw;
  max-width: 100%;
  height: 30px;
  padding-left: 10px;
  box-sizing: border-box;
  border: 1px solid #ccc;
  border-radius: 5px;
}

.school-icon-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 1px;
  margin-left: 15px;
  margin-right: 15px;
}

.products-content {
  padding: 12rpx;
}

.products-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.product-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  margin-bottom: 0rpx;
}

/* .product-name {
  font-size: 35rpx;
  font-weight: 400;
  color: #00648b;
  line-height: 1.5;
} */

.product-name {
  font-size: 32rpx; /* 稍微缩小一点，避免长文本换行太挤 */
  font-weight: 500; /* 中等字重，比400更清晰，又不生硬 */
  color: #0024f0;
  line-height: 1.2; /* 控制行间距，解决长文本换行太密的问题 */
  letter-spacing: 0.2rpx; /* 轻微字间距，让长编码文本更舒展 */
  word-break: break-all; /* 强制长文本自动换行，不溢出 */
  /* 可选：限制行数，超出显示省略号（如果需要） */
  /* display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden; */
}

.card-body {
  /* padding-top: 20rpx; */
  border-top: 1rpx solid #f0f0f0;
}

.product-code-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.odoo-table {
  display: flex;
  flex-direction: column;
  margin-top: 40rpx;
  /* margin-bottom: 16rpx; */
  border-radius: 8rpx;
  overflow: hidden;
}

.odoo-table-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #e3f2fd;
  padding: 14rpx 16rpx;
  border-bottom: 1rpx solid #bbdefb;
}

.odoo-detail-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #f1f8ff;
  padding: 12rpx 16rpx;
  border-bottom: 1rpx solid #e3f2fd;
}

.odoo-detail-row:last-child {
  border-bottom: none;
}

.table-cell {
  font-size: 24rpx;
  text-align: left;
}

.location-cell {
  flex: 2;
  color: #007AFF;
  font-weight: 500;
}

.lot-cell {
  flex: 1.5;
  color: #6c757d;
  text-align: left;
}

.qty-cell {
  flex: 1;
  color: #007AFF;
  font-weight: bold;
  text-align: right;
}

.odoo-table-header .table-cell {
  font-size: 22rpx;
  font-weight: 600;
  color: #007AFF;
}

.physical-table {
  display: flex;
  flex-direction: column;
  margin-top: 40rpx;
  margin-bottom: 40rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.physical-table-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #e6f4ea;
  padding: 14rpx 16rpx;
  border-bottom: 1rpx solid #c3e6cb;
}

.physical-detail-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #f1f8f4;
  padding: 12rpx 16rpx;
  border-bottom: 1rpx solid #e6f4ea;
}

.physical-detail-row:last-child {
  border-bottom: none;
}

.loc-cell {
  flex: 2;
  color: #28a745;
  font-weight: 500;
}

.physical-table-header .table-cell {
  font-size: 22rpx;
  font-weight: 600;
  color: #28a745;
}

.physical-table .qty-cell {
  color: #28a745;
}

.physical-detail-row.empty-row {
  justify-content: center;
}

.empty-text {
  color: #999;
  font-style: italic;
}

.inventory-summary {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background-color: #f0f7ff;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  margin-top: 8rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.summary-label {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.summary-value {
  font-size: 28rpx;
  font-weight: bold;
}

.odoo-value {
  color: #007AFF;
}

.physical-value {
  color: #28a745;
}

.diff-value {
  color: #6c757d;
}

.diff-value.positive {
  color: #6f42c1;
}

.diff-value.negative {
  color: #dc3545;
}

.summary-divider {
  width: 1rpx;
  height: 40rpx;
  background-color: #d0d7de;
}

.code-label {
  font-size: 26rpx;
  color: #999;
  margin-right: 12rpx;
}

.product-code {
  font-size: 35rpx;
  font-weight: bold;
  color: #000;
  /* font-family: monospace; */
}

.product-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  align-items: center;
}

.stat-icon {
  font-size: 36rpx;
  margin-right: 15rpx;
}

.stat-info {
  display: flex;
  flex-direction: column;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.stat-unit {
  font-size: 22rpx;
  color: #999;
}

.stat-divider {
  width: 2rpx;
  height: 40rpx;
  background-color: #e0e0e0;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.card-arrow {
  font-size: 40rpx;
  color: #ccc;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon-wrapper {
  width: 160rpx;
  height: 160rpx;
  background-color: #f0f0f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}

.list-footer {
  text-align: center;
  padding: 30rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
}



.back-to-top {
  aspect-ratio: 1 / 1;
  position: fixed;
  bottom: 50px;
  right: 30px;
  width: 40px;
  height: 40px;
  background-color: rgba(255, 255, 255, 0.4);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}