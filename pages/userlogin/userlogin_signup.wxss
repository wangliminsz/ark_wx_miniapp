/* pages/userlogin/userlogin_signup.wxss *//* login.wxss */
.u_container {
  min-height: 100vh;
  /* background-color: #f7fafc; */
  display: flex;
  flex-direction: column;
  /* align-items: center; */
  /* justify-content: center; */
  padding: 15px;
}

.signup_forget_flex_view {
  display: flex;
  flex-direction: row;
  /* align-items: center; */
  justify-content: space-between;
}

.login-box {
  height: 100%;
  width: 100%;
  max-width: 400px;
  background-color: #fff;
  border-radius: 8px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  padding: 20px;
}

.header {
  text-align: center;
  margin-top: 10px;
  margin-bottom: 48px;
}

.title {
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 8px;
}

.logo-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 8px;
}

.logo {
  width: 40px;
  height: 40px;
  margin-right: 8px;
}

.subtitle {
  font-size: 18px;
  font-weight: 600;
}

.system-name {
  font-size: 20px;
  /* font-weight: 600; */
}

.illustration {
  margin-bottom: 24px;
  text-align: center;
}

.illustration-image {
  width: 200px;
  height: 200px;
}

.form {
  display: flex;
  flex-direction: column;
}

.form-item {
  margin-bottom: 16px;
}

label {
  display: block;
  margin-bottom: 4px;
}

input {
  width: 100%;
  padding: 8px;
  border: 1px solid #ddd;
  border-radius: 4px;
}

.forgot-password {
  text-align: right;
}

.forgot-link {
  font-size: 14px;
  color: #1c64f2;
}

.login-button {
  width: 100%;
  padding: 12px;
  background-color: #1c64f2;
  color: #fff;
  border: none;
  border-radius: 4px;
  font-size: 16px;
  text-align: center;
}

.quick-access {
  margin-top: 16px;
}

.quick-access-button {
  width: 100%;
  padding: 12px;
  border: 1px solid #ddd;
  border-radius: 4px;
  font-size: 16px;
  text-align: center;
}