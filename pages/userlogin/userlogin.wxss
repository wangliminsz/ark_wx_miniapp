.ark_login-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.ark_custom-nav-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 50rpx;
}

.ark_login-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: 20rpx 0;
}

.ark_header {
  text-align: center;
  margin-bottom: 30rpx;
}

.ark_system-name {
  font-size: 50rpx;
  font-weight: normal;
}

.ark_form {
  display: flex;
  flex-direction: column;
  margin-bottom: 30rpx;
}

.ark_form-item {
  margin-bottom: 20rpx;
}

.ark_form-item label {
  display: block;
  margin-bottom: 10rpx;
}

.ark_form-item input {
  width: 100%;
  padding: 10rpx;
  border: 1px solid #ccc;
  border-radius: 4rpx;
}

.ark_login-button {
  margin-top: 30rpx;
  background-color: #007AFF;
  color: white;
}

.ark_quick-access {
  margin-top: 20rpx;
}

.ark_quick-access-button {
  background-color: #f0f0f0;
}