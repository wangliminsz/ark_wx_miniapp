<view class="page-content">
  <view class="school-list">
    <view wx:for="{{sampleRecords}}" wx:key="id" class="school-item-normal">
      <view class="school-card">
        <view class="school-info">

          <view class="client-code">{{item.y_sample_code}}</view>

          <view style="margin-top: 8px;"></view>
          <view class="client-name" style="font-weight: 540;">{{item.y_client[1]}}</view>
          <view class="client-name" style="font-weight: 540;">{{item.y_client_final[1]}}</view>

          <view style="margin-top: 8px;"></view>
          <view class="client-name" style="color:red; font-weight: 540;">执行与否: {{item.y_if_process}}</view>

          <view style="margin-top: 8px;"></view>
          <view class="client-name" style="color:blue; font-weight: 540;">{{item.y_other_requirement}}</view>
          <view style="margin-top: 8px;"></view>

          <view class="client-name" style="color:red; font-weight: 540;">样粉需求数量: {{item.y_powder_to_amount}} kg</view>

          <view style="margin-top: 8px;"></view>
          <view class="client-name">{{dateUtil.formatDate(item.create_date)}}</view>
        </view>
      </view>
    </view>
  </view>
</view>

